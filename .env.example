# Copy to .env.local and change what you need. VITE_* values are built into the
# browser bundle: they are public, so never put a secret here.

# The Tasks API. Defaults to http://localhost:8000 when unset or empty.
VITE_API_URL=http://localhost:8000

# Feature flags, one per screen. Off unless set to "true".
# VITE_FF_TASKS=true
# VITE_FF_TASK=true
# VITE_FF_SUMMARY=true
